# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. .env는 git에 올라가지 않는다.
#
# 여기 있는 이름은 계약이다. 클러스터에서는 같은 이름이 ConfigMap o2-data 와
# Secret o2-db 로 주입된다 (infra/04-platform/app_data_access.tf 가 만든다).
# 새 이름을 만들면 주입된 값이 조용히 무시되고 기본값이 쓰인다.

# CORS 허용 도메인. 콤마로 여러 개 가능.
ALLOWED_ORIGINS=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────
# 로컬에서 클러스터와 같은 RDS를 쓰려면 VPC 안이 아니므로 접근이 막힌다.
# 보안 그룹이 EKS 노드로 좁혀져 있기 때문이다. docker-compose가 같은 문자셋의
# MySQL 컨테이너를 대신 띄운다.
#
# 아래 값은 호스트에서 uvicorn을 직접 돌릴 때 기준이다(컨테이너가 3306을 연다).
# compose 안에서 돌 때는 호스트 이름이 mysql이며 compose가 그 값을 주입한다.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=o2local
DB_NAME=o2

# 리드 리플리카. 비워두면 DB_HOST로 떨어진다.
# 클러스터에서는 ConfigMap이 채워준다 (리플리카가 없는 동안에는 writer와 같은 값).
DB_READER_HOST=

# ── Valkey ───────────────────────────────────────────────────
# docker-compose가 띄우는 컨테이너. TLS 없음.
# 클러스터의 Valkey는 transit 암호화가 켜져 있어 VALKEY_TLS=true 가 주입된다.
# 평문으로 붙으면 연결이 끊긴다.
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_TLS=false
VALKEY_READER_HOST=

# ── SQS ──────────────────────────────────────────────────────
# 로컬에는 큐가 없다. 비워두면 발행을 건너뛰도록 코드에서 분기한다.
# 실제 큐를 쓰려면 개발용 AWS 자격증명이 따로 필요하다
# (클러스터에서는 Pod Identity로 들어오므로 키가 필요 없다).
SQS_ORDER_QUEUE_URL=

# HLS 플레이리스트 주소의 앞부분. 시드가 broadcasts.hls_url 을 만들 때 쓴다.
# 프론트와 MediaMTX 가 같은 ALB 뒤에 있어 상대 경로로 둔다.
HLS_BASE_URL=/hls

# ── 이벤트 SDK (o2events) ────────────────────────────────────
# 위 항목들과 달리 이 값들은 Settings 가 아니라 SDK 가 직접 읽는다.
# 그래서 config.py 에 대응 필드가 없다.
#
# O2_EVENTS_SINK 이 목적지를 정한다.
#   stdout   파드 로그로. 개발과 확인용
#   kinesis  stream-business 로. 에이전트가 읽는 경로 (전환 시 boto3·IAM·SALT 필요)
O2_SERVICE=api
O2_SERVICE_VERSION=local
O2_EVENTS_SINK=stdout
# API와 chat-gateway가 같은 값을 써야 user_key가 일치한다. 운영값은 Secret으로
# 주입하고 저장소에는 넣지 않는다.
O2_EVENTS_SALT=local-dev-only

# 빌드 전용. SDK 가 private 저장소에 있어 이미지를 만들 때 읽기 토큰이 필요하다.
# .env 가 아니라 셸에 내보낸다 — compose 가 빌드 시크릿으로 마운트한다.
#   export SDK_REPO_TOKEN=$(gh auth token)
#   docker compose build api
