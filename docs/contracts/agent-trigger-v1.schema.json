{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:o2:contract:agent.trigger.v1",
  "title": "agent.trigger.v1",
  "description": "Datadog monitor alerts and privacy-safe chat Incident Candidates normalized at the Agent entry boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_id",
    "source",
    "source_schema",
    "trigger_type",
    "idempotency_key",
    "occurred_at",
    "trace_id",
    "evidence",
    "guardrails"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "trigger_id": {
      "type": "string",
      "pattern": "^trg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source": {
      "enum": [
        "DATADOG_MONITOR",
        "CHAT_INCIDENT_CANDIDATE"
      ]
    },
    "source_schema": {
      "enum": [
        "datadog.alert.v1",
        "chat.incident_candidate.v1"
      ]
    },
    "trigger_type": {
      "enum": [
        "MONITOR_ALERT",
        "USER_SYMPTOM_CLUSTER"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "evidence": {
      "type": "object"
    },
    "guardrails": {
      "$ref": "#/$defs/guardrails"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "DATADOG_MONITOR"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source_schema": {
            "const": "datadog.alert.v1"
          },
          "trigger_type": {
            "const": "MONITOR_ALERT"
          },
          "evidence": {
            "$ref": "#/$defs/datadog_evidence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "CHAT_INCIDENT_CANDIDATE"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source_schema": {
            "const": "chat.incident_candidate.v1"
          },
          "trigger_type": {
            "const": "USER_SYMPTOM_CLUSTER"
          },
          "evidence": {
            "$ref": "#/$defs/chat_evidence"
          }
        }
      }
    }
  ],
  "$defs": {
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_mode",
        "automatic_remediation_allowed",
        "must_preserve_uncertainty",
        "raw_chat_included"
      ],
      "properties": {
        "analysis_mode": {
          "const": "READ_ONLY"
        },
        "automatic_remediation_allowed": {
          "const": false
        },
        "must_preserve_uncertainty": {
          "const": true
        },
        "raw_chat_included": {
          "const": false
        }
      }
    },
    "datadog_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "cycle_key",
        "monitor_id",
        "transition",
        "priority",
        "env",
        "service",
        "alert_title",
        "alert_body",
        "alert_query",
        "host",
        "tags",
        "link"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cycle_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "monitor_id": {
          "type": "string",
          "maxLength": 128
        },
        "transition": {
          "enum": [
            "Triggered",
            "Re-Triggered",
            "Recovered",
            "Warn",
            "No Data",
            "Renotify"
          ]
        },
        "priority": {
          "type": "string",
          "maxLength": 64
        },
        "env": {
          "type": "string",
          "maxLength": 128
        },
        "service": {
          "type": "string",
          "maxLength": 128
        },
        "alert_title": {
          "type": "string",
          "maxLength": 1000
        },
        "alert_body": {
          "type": "string",
          "maxLength": 30000
        },
        "alert_query": {
          "type": "string",
          "maxLength": 30000
        },
        "host": {
          "type": "string",
          "maxLength": 512
        },
        "tags": {
          "type": "string",
          "maxLength": 30000
        },
        "link": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "chat_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_type",
        "broadcast_id",
        "suspected_surface",
        "confidence",
        "window_start",
        "window_end",
        "matched_messages",
        "unique_users",
        "strong_signal_count",
        "weak_signal_count",
        "matched_rule_ids",
        "metric_status",
        "root_cause",
        "requires_metric_corroboration"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^cand_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "candidate_type": {
          "const": "USER_PERCEIVED_LATENCY"
        },
        "broadcast_id": {
          "type": "string",
          "pattern": "^bc_[0-9]+$"
        },
        "suspected_surface": {
          "enum": [
            "READ_PATH",
            "PLAYBACK",
            "CHAT",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "enum": [
            "MEDIUM",
            "LOW"
          ]
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "matched_messages": {
          "type": "integer",
          "minimum": 1
        },
        "unique_users": {
          "type": "integer",
          "minimum": 1
        },
        "strong_signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "weak_signal_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "metric_status": {
          "const": "NOT_CHECKED"
        },
        "root_cause": {
          "const": "UNDETERMINED"
        },
        "requires_metric_corroboration": {
          "const": true
        }
      }
    }
  }
}
